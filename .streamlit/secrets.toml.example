# Copy this to `.streamlit/secrets.toml` (which is gitignored) for local runs,
# or paste the same contents into the "Secrets" box in Streamlit Community Cloud
# (App → Settings → Secrets).
ANTHROPIC_API_KEY = "sk-ant-your-key-here"

# Optional: a shared password friends must enter before using the app. Leave it
# out for no gate. Recommended for a public link so strangers can't spend your key.
# APP_PASSWORD = "choose-a-word-to-share-with-friends"

# Optional overrides:
# JOBAID_MODEL = "claude-opus-4-8"
# ANTHROPIC_BASE_URL = "https://your-internal-gateway.example.com"
