# Copy to .env.local. Never commit real keys. AI calls run server-side only.

# AI provider: "mock" (default, offline/deterministic) or "anthropic".
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Upload + processing limits (see README).
MAX_UPLOAD_BYTES=524288000        # 500 MB
MAX_VIDEO_DURATION_SECONDS=1800   # 30 min
JOB_RETENTION_MINUTES=60          # temp data deleted after this many minutes

# Concurrency caps for expensive work.
MAX_CONCURRENT_FFMPEG=2
MAX_CONCURRENT_AI=2
